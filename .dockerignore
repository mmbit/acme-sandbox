# The coordinator's image is the one built from the repo's root (infra/compose.yaml): it takes only what its Dockerfile
# copies, the platform's code and the company's own parts
*
!platform/coordinator/package.json
!platform/coordinator/package-lock.json
!platform/coordinator/src
