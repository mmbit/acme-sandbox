# The company's names on its server and accounts: plain values, never secrets (those are the board's, on the desk
# phone). One KEY=value per line, no quotes and no spaces: infra/'s scripts source it, backup.py and the coordinator
# read it as it is. HQ's own address goes in infra/host once the domain exists (without it, the server uses
# <ip>.sslip.io); the inbox's domain is brand.yaml's mail.domain.
# The server's name for its folders and services: /etc/<it>, /opt/<it>, /var/lib/<it>, the <it>-sync, <it>-backup units
SERVER_NAME=company
# The Hetzner Cloud server (provision.sh, resize.sh)
SERVER=company-1
# The R2 bucket for the nightly off-site backup (backup.py)
BACKUP_BUCKET=company-backups
# What the nightly backup leaves out of the coordinator's data volume, if anything: paths in it, comma-separated, * and ? as
# in a shell (backup.py)
#BACKUP_LEFT_OUT=secrets/SAMPLE_DROP_*
# The most every product's copies (their /data/backup/) add to a night's backup, in MB compressed (backup.py). Each MB
# also keeps 49.5 MB of the bucket free for the nights to come. Without it, no product's copies go and the board hears
#BACKUP_PRODUCTS_MB=20
# The bucket's room past R2's free 10 GB, in whole GB (backup.py): storage past 10 GB is a spending approval. Without
# it, 10 GB; a value that isn't a whole number stops the nightly backup until it's fixed.
#BACKUP_BUCKET_GB=30
# What agents commit as: <agent id>@AGENT_EMAIL_DOMAIN for their own work, AGENTS_EMAIL for a job clone's commits
AGENT_EMAIL_DOMAIN=agents.example.com
AGENTS_EMAIL=agents@example.com
# The worker's seats, id:engine, comma-separated (infra/compose.yaml); without it, one Claude and one Codex seat. A
# seat on a big plan may name how far it runs before keeping the rest for the board: claude-1:claude:95 (90 if unset)
#SEATS=claude-1:claude,codex-1:codex
# The worker's memory for agent jobs, no swap (infra/compose.yaml): the server's memory less a call's peak,
# speech-to-text, HQ and the products; without it, 7168m, sized for a 16 GB server
#WORKER_MEMORY=7168m
# The support chat's session cookie names, comma-separated, if the company has one (the product `care`: infra/products.py)
#CARE_COOKIES=chat,__Host-chat
# The email service the platform sends through (platform/coordinator/src/mailout.ts: lettermint), its key on the desk phone
# (setting it up: platform/care/docs/email.md)
#EMAIL_SERVICE=lettermint
# What the products' checkouts offer besides cards, comma-separated: immediate methods switched on in the company's Stripe
# account (ideal, bancontact, eps, wero; platform/coordinator/src/payments.ts methods())
#PAYMENT_METHODS=ideal,bancontact

# Temporary deploy-build peak, in GiB, excluded from job disk shares. Set this to the measured additional
# disk used during deployment. The default 0 reserves no build space. Database journal/copy space is separate.
#DEPLOY_BUILD_RESERVE_GB=0
