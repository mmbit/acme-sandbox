# A care deployment's image (platform/care/Dockerfile) is built from the repo's root: this file is BuildKit's ignore for
# that Dockerfile alone (the root .dockerignore stays the coordinator's). It takes only what the Dockerfile copies, the
# engine and a plug-in folder, without their tests, demo or eval. It can't name the deployment's own folder (the
# PLUGIN build argument), so it lets in every product's plug-in parts and nothing else of a product: never an app/
*
!platform/care/package.json
!platform/care/src
!platform/care/public
!platform/care/magick
!shared/pictures/size.ts
!shared/net/net.ts
!shared/routes/routes.ts
!shared/format/format.js
!shared/holidays/holidays.js
!shared/ordernumber/ordernumber.js
!kits
!products/*/care.ts
!products/*/package.json
!products/*/src
!products/*/public
!products/*/kb
# each app's own words
!products/*/apps
**/node_modules
**/*.test.ts
**/*.test.js
**/*.test.mjs
platform/care/demo
products/*/demo
products/*/eval
