// The shell's build settings (README.md). A company's address and app id come from its theme/ios.xcconfig.
// (In an .xcconfig, "//" starts a comment: an address writes it as "/$()/".)
HQ_URL = http:/$()/localhost:8080
PRODUCT_BUNDLE_IDENTIFIER = com.example.hq
#include? "../../theme/ios.xcconfig"

PRODUCT_NAME = HQ
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.5
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0

INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = HQ
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_NSMicrophoneUsageDescription = For calls and voice notes.
INFOPLIST_KEY_NSCameraUsageDescription = For photos you add.
